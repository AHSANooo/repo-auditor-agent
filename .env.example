# Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── LLM Provider ─────────────────────────────────────────────
# Your OpenAI-compatible API key.
# Supports: OpenAI, Google Gemini (via OpenAI-compat), DeepSeek, Groq, Ollama
OPENAI_API_KEY=your_api_key_here

# Optional: Override the API base URL to use a different provider
# Examples:
#   Google Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
#   DeepSeek:      https://api.deepseek.com/v1
#   Groq:          https://api.groq.com/openai/v1
#   Ollama local:  http://localhost:11434/v1
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ── Model Selection ───────────────────────────────────────────
# Default model to use for the audit agent.
# Examples: gpt-4o-mini, gpt-4o, gemini-1.5-pro, deepseek-chat, llama3.1
AUDIT_MODEL=gpt-4o-mini

# ── Agent Behaviour ───────────────────────────────────────────
# Maximum number of ReAct iterations before the agent force-submits.
# Increase for thorough audits on large repos (costs more tokens).
MAX_ITERATIONS=20

# ── Logging ──────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

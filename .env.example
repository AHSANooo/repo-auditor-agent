# Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── LLM Provider ─────────────────────────────────────────────
# Your OpenAI-compatible API key.
# Recommended: Google Gemini (best tool-calling + 1M token context)
OPENAI_API_KEY=your_api_key_here

# ── API Base URL ──────────────────────────────────────────────
# Set to switch providers. Leave unset for OpenAI (default).
#
# Google Gemini (recommended — best for tool-calling & context):
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#
# Other supported providers:
#   DeepSeek:    https://api.deepseek.com/v1
#   Groq:        https://api.groq.com/openai/v1
#   Ollama:      http://localhost:11434/v1

# ── Model Selection ───────────────────────────────────────────
# Recommended models per provider:
#   Google Gemini: gemini-3.5-flash-lite (fast, 1M context, efficient & verified tool-calling)
#   OpenAI:        gpt-4o-mini
#   DeepSeek:      deepseek-chat
#   Groq:          qwen/qwen3.8-27b
#   Ollama:        llama3.1
AUDIT_MODEL=gemini-3.5-flash-lite

# ── Agent Behaviour ───────────────────────────────────────────
# Maximum number of ReAct iterations before the agent force-submits.
# Increase for thorough audits on large repos (costs more tokens).
MAX_ITERATIONS=20

# ── Logging ──────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
